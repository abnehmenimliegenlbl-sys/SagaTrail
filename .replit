modules = ["nodejs-24", "python-3.11", "ruby-3.2", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Stripe Webhook (Test)"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "EAS Build Submit"

[[workflows.workflow]]
name = "Stripe Webhook (Test)"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/stripe-listen.sh"

[[workflows.workflow]]
name = "EAS Build Submit"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "if [ ! -f /tmp/eas-go ]; then echo \"Sicherung: kein Build ausgelöst. Zum Bauen zuerst 'touch /tmp/eas-go', dann Workflow neu starten.\"; sleep 3600; exit 0; fi; rm -f /tmp/eas-go; cd artifacts/mobile && GIT_OPTIONAL_LOCKS=0 EAS_SKIP_AUTO_FINGERPRINT=1 EXPO_APPLE_TEAM_ID=R4254XKT8S npx eas build --platform ios --profile production --auto-submit --no-wait --non-interactive 2>&1 | tee /tmp/eas-build.log; echo EAS_DONE >> /tmp/eas-build.log; sleep 3600"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["revenuecat:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

